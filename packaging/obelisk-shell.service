# Reruns the shell when it dies (ADR-0059 decision 4).
#
# niri's `spawn-at-startup` does not restart what it spawns. That is niri issue #2986's answer
# verbatim -- "niri doesn't restart that for you, it is up to you to recover it" -- so the recovery
# is a service manager's, and this file is it. Start the unit from the compositor rather than
# spawning the binary directly:
#
#     spawn-at-startup "systemctl" "--user" "start" "--no-block" "obelisk-shell.service"
#
# Install: put both binaries in ~/.local/lib/obelisk. They have to be siblings, because the
# Supervisor resolves the Renderer next to itself (`renderer_binary_path` in supervisor/src/main.rs;
# no install-path configuration exists yet, ADR-0025). Then copy this file to
# ~/.config/systemd/user/ and run `systemctl --user daemon-reload`. For a dev run against the build
# tree, point ExecStart at target/debug/supervisor instead.

[Unit]
Description=Obelisk shell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/lib/obelisk/supervisor
# `always`, not `on-failure`: a Supervisor killed by a stray SIGTERM exits 0, and the shell should
# come back from that too. Session end does not go through here at all -- `PartOf=` makes systemd
# *stop* the unit, and a stop never restarts. Stopping the unit is also what collects a Renderer or
# a `process.run` child that outlived a Supervisor which ran none of its own cleanup, since the
# whole control group goes with it.
Restart=always
# A Supervisor that dies during its own startup would otherwise burn systemd's start limit in well
# under a second and stop the shell for good.
RestartSec=1
# ADR-0059 decision 3. Exit 3 is ADR-0058's restart brake giving up: three Renderers died
# inside a minute, which is a config that kills whatever it is handed rather than a transient.
# Restarting hands the same config to three more, once a minute, forever, and that is slow enough
# that systemd's own start limit (5 starts in 10s by default) never sees it.
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
